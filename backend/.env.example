# LocalFix Backend Environment Variables

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/localfix

# JSON Web Token Secret & Expiry
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP Verification Configuration
OTP_SECRET=change_this_to_another_secure_secret_for_hashing_otps
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
REQUIRE_OTP_LOGIN=true

# =============================================================================
# TRANSACTIONAL EMAIL DELIVERY PROVIDER
# Option 1: Resend HTTP API (Recommended for modern web apps)
# =============================================================================
RESEND_API_KEY=
EMAIL_FROM=LocalFix <no-reply@your-verified-localfix-domain.com>

# Option 2: Custom SMTP (Brevo / Amazon SES / Mailgun / Postmark / Zoho)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# =============================================================================
# SMS OTP DELIVERY PROVIDERS (INDIA & GLOBAL)
# Option 1: MSG91 (DLT Compliant Flow API for India)
# =============================================================================
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=LOCFIX

# Option 2: Twilio (Global SMS API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 3: Fast2SMS (Indian Gateway)
FAST2SMS_API_KEY=
