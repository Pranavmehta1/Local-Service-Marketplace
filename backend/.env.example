# LocalFix Backend Environment Variables

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/localfix

# JSON Web Token Secret & Expiry
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP Verification Configuration
OTP_SECRET=change_this_to_another_secure_secret_for_hashing_otps
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
REQUIRE_OTP_LOGIN=true

# =============================================================================
# OFFICIAL LOCALFIX GMAIL SMTP CONFIGURATION (Recommended)
# =============================================================================
# 1. Dedicated Gmail account (e.g. LocalFix@gmail.com or LocalFix.Official@gmail.com)
# 2. Enable 2-Step Verification on this Google account
# 3. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=LocalFix.Official@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=LocalFix <LocalFix.Official@gmail.com>

# =============================================================================
# ALTERNATIVE: Custom SMTP (Brevo / Amazon SES / Mailgun / Zoho)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_PASS=

# =============================================================================
# ALTERNATIVE: Resend HTTP REST API
# =============================================================================
RESEND_API_KEY=

# =============================================================================
# SMS OTP DELIVERY PROVIDERS (INDIA & GLOBAL)
# Option 1: MSG91 (DLT Compliant Flow API for India)
# =============================================================================
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=LOCFIX

# Option 2: Twilio (Global SMS API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 3: Fast2SMS (Indian Gateway)
FAST2SMS_API_KEY=
